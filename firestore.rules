rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() { return request.auth != null; }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin()           { return isLoggedIn() && getUserRole() == 'admin'; }
    function isAdminOrSubAdmin() { return isLoggedIn() && getUserRole() in ['admin', 'subadmin']; }
    function isHmcMember()       { return isLoggedIn() && getUserRole() in ['admin', 'subadmin', 'member']; }
    function isChiefWarden()     { return isLoggedIn() && getUserRole() == 'chief_warden'; }
    function isHostelWarden()    { return isLoggedIn() && getUserRole() == 'hostel_warden'; }
    function isHostelSupervisor(){ return isLoggedIn() && getUserRole() == 'hostel_supervisor'; }
    function isHostelAuthority() { return isChiefWarden() || isHostelWarden() || isHostelSupervisor(); }
    function isAnyUser()         { return isLoggedIn(); }  // includes students

    // ── Users ──────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAnyUser();
      allow create: if isAdminOrSubAdmin() ||
        // Students migrating from pending_users after email verification
        (request.resource.data.role == 'student' && request.auth.uid == userId) ||
        // First setup admin account creation
        (!exists(/databases/$(database)/documents/meta/setup) && request.auth.uid == userId && request.resource.data.role == 'admin');
      allow update: if isHmcMember() || isHostelAuthority() || request.auth.uid == userId;
      allow delete: if isAdminOrSubAdmin();
    }

    // ── Pending Users (pre-verification staging) ───────────
    // Registration data is stored here before email verification.
    // On first verified login, the client migrates data to /users/{uid}.
    match /pending_users/{userId} {
      allow read:   if isLoggedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isLoggedIn() && request.auth.uid == userId;
      allow update: if isLoggedIn() && request.auth.uid == userId;
      allow delete: if isLoggedIn() && (request.auth.uid == userId || isAdminOrSubAdmin());
    }

    // ── Unique ID index ────────────────────────────────────
    match /uniqueIds/{uniqueId} {
      allow read:  if isAnyUser();
      allow write: if isAdminOrSubAdmin() || !exists(/databases/$(database)/documents/meta/setup);
    }

    // ── Counters ───────────────────────────────────────────
    match /counters/{counterId} {
      allow read:  if isHmcMember() || isHostelAuthority() || isAdminOrSubAdmin();
      allow write: if isHmcMember() || isHostelAuthority() || isAdminOrSubAdmin() || !exists(/databases/$(database)/documents/meta/setup);
    }

    // ── Tasks ──────────────────────────────────────────────
    match /tasks/{taskId} {
      // Any logged-in user can read — avoids secondary role lookup failures.
      // Client-side filtering ensures users only see their own tasks.
      allow read:   if isLoggedIn();
      allow create: if isLoggedIn();  // Any logged-in user (members, heads, supervisors) can create tasks
      allow update: if isLoggedIn();  // Any logged-in user who is assignee or assigner can update
      allow delete: if isAdminOrSubAdmin() ||
                       request.auth.uid == resource.data.assignedByUid;
    }

    // ── Categories ─────────────────────────────────────────
    match /categories/{catId} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── Events (Calendar) ──────────────────────────────────
    match /events/{eventId} {
      allow read:  if isAnyUser();   // students can see calendar
      allow write: if isAdmin();
    }

    // ── Event Permission Templates ─────────────────────────
    match /event_permission_templates/{templateId} {
      allow read:  if isHmcMember();
      allow write: if isHmcMember();
    }

    // ── Campus Events ──────────────────────────────────────
    match /campus_events/{eventId} {
      allow read:  if true;
      allow write: if isHmcMember();

      match /registrations/{regId} {
        allow read: if isHmcMember();
        allow create: if true;
        allow update, delete: if isHmcMember();
      }
      match /equipment_requests/{reqId} {
        allow read: if isHmcMember();
        allow write: if isHmcMember();
      }
      match /meal_passes/{passId} {
        allow read: if isHmcMember();
        allow write: if isHmcMember();
      }
      match /gate_passes/{passId} {
        allow read: if isHmcMember();
        allow write: if isHmcMember();
      }
      match /stall_bookings/{bookingId} {
        allow read: if isHmcMember();
        allow create: if true;
        allow update, delete: if isHmcMember();
      }
      match /accommodation/{reqId} {
        allow read: if isHmcMember();
        allow write: if isHmcMember();
      }
      match /external_requests/{reqId} {
        allow read: if isHmcMember();
        allow create: if true;
        allow update, delete: if isHmcMember();
        match /messages/{msgId} {
          allow read: if isHmcMember();
          allow create: if true;
          allow update, delete: if isHmcMember();
        }
      }
      match /expenditures/{expId} {
        allow read: if isHmcMember();
        allow write: if isHmcMember();
      }
    }

    // ── Chat rooms ─────────────────────────────────────────
    match /chatRooms/{roomId} {
      allow read:  if isHmcMember();
      allow write: if isHmcMember();

      match /messages/{messageId} {
        allow read:   if isHmcMember();
        allow create: if isHmcMember();
        allow delete: if isAdmin();
      }
    }

    // ── Committee (public-facing) ──────────────────────────
    match /committee/{memberId} {
      allow read:  if isAnyUser();   // all users (students too) can read
      allow write: if isAdmin();
    }

    // ── Meta (setup flag) ──────────────────────────────────
    match /meta/{docId} {
      allow read:  if true;
      allow write: if isAdminOrSubAdmin() ||
                      (docId == 'menu' && (getUserRole() in ['admin', 'subadmin'] || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.category == 'mess' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.post == 'Head'))) ||
                      (docId == 'hostel' && (getUserRole() in ['admin', 'subadmin'] || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.category == 'hostel' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.post == 'Head'))) ||
                      (docId in ['event_settings', 'equipment_catalog'] && (getUserRole() in ['admin', 'subadmin'] || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.category in ['events', 'event'] && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.post in ['Head', 'POC', 'head', 'poc', 'Coordinator', 'coordinator']))) ||
                      !exists(/databases/$(database)/documents/meta/setup);
    }

    // ── Mess Menus ──────────────────────────────────────────
    match /menus/{menuId} {
      allow read:  if isAnyUser();
      allow write: if isHmcMember();
    }

    // ── Mess Feedback ─────────────────────────────────────────
    match /mess_feedback/{feedbackId} {
      allow read:  if isAnyUser();
      allow create: if isAnyUser();
      allow update, delete: if isHmcMember();
    }

    // ── Food Testing Assignments ────────────────────────────
    match /food_assignments/{assignId} {
      allow read:  if isAnyUser();
      allow write: if isHmcMember();
    }

    // ── TDS Assignments ────────────────────────────────────
    match /tds_assignments/{docId} {
      allow read:  if isLoggedIn();
      allow write: if isHmcMember();
    }

    // ── Hygiene Assignments ────────────────────────────────
    match /hygiene_assignments/{docId} {
      allow read:  if isLoggedIn();
      allow write: if isHmcMember();
    }

    // ── Hostel TDS Sessions & Readings ───────────────────────
    match /hostel_tds_sessions/{docId} {
      allow read:  if isLoggedIn();
      allow write: if isHmcMember() || isHostelAuthority();
    }

    match /hostel_tds/{docId} {
      allow read:  if isLoggedIn();
      allow write: if isHmcMember() || isHostelAuthority();
    }

    // ── Hostel Cleanliness Sessions & Inspections ────────────
    match /hostel_hygiene_sessions/{docId} {
      allow read:  if isLoggedIn();
      allow write: if isHmcMember() || isHostelAuthority();
    }

    match /hostel_hygiene/{docId} {
      allow read:  if isLoggedIn();
      allow write: if isHmcMember() || isHostelAuthority();
    }

    // ── Hostel Electricity Logs ──────────────────────────────
    match /hostel_electricity/{docId} {
      allow read:  if isLoggedIn();
      allow write: if isLoggedIn() && (getUserRole() == 'admin' || isHostelAuthority() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.category == 'hostel');
    }

    // ── Hostels ─────────────────────────────────────────────
    match /hostels/{hostelId} {
      allow read:  if isLoggedIn();
      allow write: if isHmcMember() || isHostelAuthority();
    }

    // ── Hostel Students ──────────────────────────────────────
    match /hostel_students/{studentId} {
      allow read:  if isLoggedIn();
      allow write: if isHmcMember() || isHostelAuthority();
    }

    // ── Laundry Groups ──────────────────────────────────────
    match /laundry_groups/{groupId} {
      allow read:  if isLoggedIn();
      allow write: if isLoggedIn();
    }

    // ── Laundry Schedules ───────────────────────────────────
    match /laundry_schedules/{scheduleId} {
      allow read:   if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isLoggedIn();
      allow delete: if isLoggedIn();
    }

    // ── Complaints & Feedback ──────────────────────────────
    match /complaints/{complaintId} {
      allow read:   if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isHmcMember() || isHostelAuthority();
      allow delete: if isAdmin();
    }

    // ── Audit Logs ─────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read:   if isAdmin();
      allow create: if isHmcMember();
      allow delete: if isAdmin();
    }

    // ── Notices Board ──────────────────────────────────────
    match /notices/{noticeId} {
      allow read:   if isLoggedIn();
      allow create: if isAdminOrSubAdmin();
      allow update: if isAdminOrSubAdmin();
      allow delete: if isAdminOrSubAdmin();
    }
  }
}

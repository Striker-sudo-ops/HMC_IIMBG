{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "*.md",
      "serve.py",
      "cors.json",
      "package.json",
      "package-lock.json",
      "capacitor.config.json",
      "*.txt",
      "android/**",
      "www/**",
      "*.jks",
      "*.keystore",
      "*.sh",
      "*.bat",
      "gradlew",
      "gradlew.bat"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
